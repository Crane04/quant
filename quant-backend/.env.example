NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/quant

# Auth (opaque, DB-backed session tokens — see src/models/Session.ts)
STUDENT_SESSION_EXPIRES_IN=30d
ADMIN_SESSION_EXPIRES_IN=7d
OTP_EXPIRES_IN_MINUTES=10

# Internal service auth (trusted-service routes; also used by the in-process
# WhatsApp bot logic where an HTTP hop is ever needed)
BOT_SERVICE_API_KEY=change_me_bot_key

# Admin dashboard auth (email+password login, separate session token from students')
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=xyz123

# Meta WhatsApp Cloud API — the bot itself (webhook receiver at /webhook/whatsapp)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=
# RSA private key for the WhatsApp Flow endpoint (/webhook/flow), base64-encoded PEM.
# Generate: openssl genrsa -out private.pem 2048 && base64 -i private.pem | tr -d '\n'
META_WA_FLOW_PRIVATE_KEY_B64=

# Optional — AI-assisted intent detection for the WhatsApp bot (falls back to
# plain keyword matching if unset)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Base URL this API is publicly reachable at — used to build /view/:id links
# sent over WhatsApp for course material
APP_BASE_URL=http://localhost:4000

# Email (Resend — for matric/email verification OTP)
RESEND_API_KEY=
MAIL_FROM="Quant <no-reply@quant.app>"

# Cloudflare R2 (S3-compatible) — lecture PDFs, documents
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
